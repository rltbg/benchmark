<Project Sdk="Microsoft.NET.Sdk">
  <!-- OutputType Exe (pas WinExe) : stdout capturable partout. Tete bureau (Linux / Windows / macOS) : F#. NativeAOT : dotnet publish -r <rid> -p:PublishAot=true -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>avalonia-spike</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <BuiltInComInteropSupport>false</BuiltInComInteropSupport>
  </PropertyGroup>
  <PropertyGroup Condition="'$(PublishAot)' == 'true'">
    <IsAotCompatible>true</IsAotCompatible>
    <IlcOptimizationPreference>Speed</IlcOptimizationPreference>
    <StripSymbols>true</StripSymbols>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.fs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="$(AvaloniaVersion)" />
    <ProjectReference Include="../Spike.Ui/Spike.Ui.fsproj" />
  </ItemGroup>
</Project>

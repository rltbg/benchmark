<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OtherFlags>--nowarn:0086 --mlcompatibility --nologo</OtherFlags>
    <OutputType>Library</OutputType>
    <LangVersion>5.0</LangVersion>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Prims.fs" />
    <Compile Include="FStar_Pervasives_Native.fs" />
    <Compile Include="FStar_List_Tot_Base.fs" />
    <Compile Include="FStar_UInt8.fs" />
    <Compile Include="FStar_UInt32.fs" />
  </ItemGroup>
</Project>

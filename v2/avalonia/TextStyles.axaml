<!-- Styles AvaloniaEdit (variante Simple), resolus a la compilation (XAML compile) : sur pour le trimming/NativeAOT.
     Charge uniquement pour le scenario text. -->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="AvaloniaBenchUi.TextStyles">
  <StyleInclude Source="avares://AvaloniaEdit/Themes/Simple/AvaloniaEdit.xaml" />
</Styles>

import { RowData, Bench } from "bench.slint";

// Ligne standard (L1, L3, F2, F3, I1, I2) : pastille ronde 32 px, titre, sous-titre (2+ lignes, rogné), prix.
export component RowBody inherits Rectangle {
    in property <RowData> d;
    height: d.h;
    background: d.h > 0px ? #ffffff : transparent;
    Rectangle {
        x: 12px;
        y: (parent.height - 32px) / 2;
        width: 32px;
        height: 32px;
        border-radius: 16px;
        background: d.color;
    }
    Text {
        x: 60px;
        y: 6px;
        width: parent.width - 60px - 130px;
        text: d.title;
        font-size: 16px;
        font-weight: 700;
        color: #202020;
        overflow: elide;
    }
    Rectangle {
        x: 60px;
        y: 28px;
        width: parent.width - 60px - 130px;
        height: parent.height - 32px;
        clip: true;
        Text {
            y: 0px;
            width: parent.width;
            text: d.sub;
            wrap: word-wrap;
            vertical-alignment: top;
            font-size: 12px;
            color: #606060;
        }
    }
    Text {
        x: parent.width - 120px;
        y: (parent.height - 20px) / 2;
        width: 108px;
        horizontal-alignment: right;
        text: d.price;
        font-size: 16px;
        color: #107010;
    }
    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: #e0e0e0;
    }
}

// Ligne dense riche (L2) : base de 6 éléments + `Bench.puces` puces (rect arrondi coloré + texte court).
export component DenseBody inherits Rectangle {
    in property <RowData> d;
    height: d.h;
    background: d.h > 0px ? #ffffff : transparent;
    // 1. pastille ronde
    Rectangle {
        x: 8px;
        y: (parent.height - 16px) / 2;
        width: 16px;
        height: 16px;
        border-radius: 8px;
        background: d.color;
    }
    // 2. titre
    Text {
        x: 32px;
        y: (parent.height - 14px) / 2;
        width: 110px;
        text: d.title;
        font-size: 12px;
        font-weight: 700;
        color: #202020;
        overflow: elide;
    }
    // 3. sous-titre sur 2 lignes (rogné)
    Rectangle {
        x: 146px;
        y: 1px;
        width: 220px;
        height: parent.height - 2px;
        clip: true;
        Text {
            y: 0px;
            width: parent.width;
            height: parent.height;
            text: d.sub;
            wrap: word-wrap;
            overflow: elide;
            vertical-alignment: center;
            font-size: 9px;
            color: #606060;
        }
    }
    // 4. barre de progression
    Rectangle {
        x: 376px;
        y: (parent.height - 6px) / 2;
        width: 100px;
        height: 6px;
        border-radius: 3px;
        background: #e0e0e0;
        Rectangle {
            width: parent.width * d.prog;
            border-radius: 3px;
            background: #3b7bd6;
        }
    }
    // 5. bascule : rect arrondi + cercle
    Rectangle {
        x: 490px;
        y: (parent.height - 14px) / 2;
        width: 28px;
        height: 14px;
        border-radius: 7px;
        background: d.on ? #3ba55d : #b0b0b0;
        Rectangle {
            x: d.on ? 15px : 2px;
            y: 2px;
            width: 10px;
            height: 10px;
            border-radius: 5px;
            background: white;
        }
    }
    // 6. prix
    Text {
        x: parent.width - 80px;
        y: (parent.height - 14px) / 2;
        width: 72px;
        horizontal-alignment: right;
        text: d.price;
        font-size: 12px;
        color: #107010;
    }
    // puces : (K-6)/2 x (rect arrondi coloré + texte court)
    for p in Bench.puces: Rectangle {
        x: 530px + p * min(48px, 650px / Bench.puces);
        y: (parent.height - 16px) / 2;
        width: min(48px, 650px / Bench.puces) - 1px;
        height: 16px;
        border-radius: 4px;
        background: Colors.hsv(mod(d.hue + p * 37, 360), 0.55, 0.95, 1.0);
        Text {
            text: "c" + p;
            font-size: 8px;
            color: #202020;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: #e0e0e0;
    }
}

export component PoolRow inherits RowBody {
    y: self.d.y;
}
export component PoolDense inherits DenseBody {
    y: self.d.y;
}
